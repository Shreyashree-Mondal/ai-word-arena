# Settings for a hosted copy of the game.
#
#   * On Streamlit Community Cloud: paste this into  Advanced settings > Secrets
#   * Locally: copy this file to  .streamlit/secrets.toml   (that file is git-ignored)
#
# NEVER commit real keys. Only this .example file belongs in the repository.

# Public site: turns off custom topics, the agent, live AI puzzles and auto-saving AI puzzles,
# and limits AI hints/feedback per visitor. Recommended for anything on the open internet.
AIWORD_PUBLIC_MODE = "1"

# Optional: switch on AI hints and feedback (paste your own key; keep the quotes).
# GROQ_API_KEY = "paste-your-key-here"
# AIWORD_API_MODEL = "openai/gpt-oss-20b"

# Optional: how many AI hints/feedback one visitor may use (default 15).
# AIWORD_AI_SESSION_LIMIT = "10"
